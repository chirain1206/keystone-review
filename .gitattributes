# 统一换行符为 LF，避免 Windows / macOS / Linux 协作时出现整文件 diff
* text=auto eol=lf

# 源码与配置强制 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不参与换行转换
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

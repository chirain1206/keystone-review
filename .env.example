# ============================================================
# WoW M+ AI 复盘教练 —— 环境变量模板
# 复制为 .env.local（本地开发）并在部署平台配置同名字段。
# 全部为空时应用进入 MOCK 模式：所有外部服务用本地 mock 适配器，
# 可在无真实密钥的情况下跑通完整流程（mock 模式随机生成 6 位验证码，
# 打印在服务端控制台 [email:mock] 行）。
# 密钥绝不提交进仓库。
# ============================================================

# --- Supabase（账号 + Postgres + RLS）---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend（验证码邮件 SMTP）---
RESEND_API_KEY=
EMAIL_FROM="WoW 复盘教练 <onboarding@example.com>"

# --- DeepSeek（报告生成 / 问答）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Warcraft Logs v2 API ---
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- 通用 ---
APP_URL=http://localhost:3000
# 开发调试开关：打印验证码/API 细节到服务端日志
DEV_LOG_CODES=false
